          "id": "a6b7ecaa-600f-4ecd-ad24-ae761142be6b",
          "name": "Get organization analytics",
          "request": {
            "name": "Get organization analytics",
            "description": {
              "content": "Returns time-series analytics data for an organization in 15-minute intervals. The time range is limited to a maximum of 24 hours and must be specified using RFC 3339 timestamps.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "organizations",
                ":organizationId",
                "analytics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "(Required) Start of the analytics time range in RFC 3339 format"
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "(Required) End of the analytics time range in RFC 3339 format"
