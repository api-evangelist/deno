                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/organizations/:organizationId/analytics?since=<dateTime>&until=<dateTime>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "organizations",
                        ":organizationId",
                        "analytics"
                      ],
                      "query": [
                        {
                          "description": "(Required) Start of the analytics time range in RFC 3339 format",
                          "key": "since",
                          "value": "<dateTime>"
                        },
                        {
                          "description": "(Required) End of the analytics time range in RFC 3339 format",
                          "key": "until",
                          "value": "<dateTime>"
