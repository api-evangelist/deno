    {
      "id": "3ab6cd19-5d50-4fd5-ae1a-bdc0ee8da729",
      "name": "Logs",
      "description": {
        "content": "Query or stream runtime application logs for apps",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0a3da872-a1bf-4565-8b89-60b7670e7c58",
          "name": "Get or stream app logs",
          "request": {
            "name": "Get or stream app logs",
            "description": {
              "content": "Queries or streams runtime logs for an application. A start datetime is required. When an end datetime is omitted, the endpoint streams logs in real time using Server-Sent Events or newline-delimited JSON depending on the Accept header. Supports filtering by revision ID, log level, and full-text search. Cursor-based pagination applies to historical queries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "apps",
                ":app",
                "logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "(Required) Start of the log time range as an ISO 8601 datetime"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "End of the log time range as an ISO 8601 datetime. Omit to stream logs in real time."
                },
                {
                  "disabled": false,
                  "key": "revision_id",
                  "value": "<string>",
                  "description": "Filter logs to a specific revision by its ID"
                },
                {
                  "disabled": false,
                  "key": "level",
                  "value": "<string>",
                  "description": "Filter logs by severity level"
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Full-text search query to filter log messages"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Pagination cursor for historical log queries"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of log entries to return (1-1000)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "app",
                  "description": "(Required) App UUID or human-readable slug"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
